{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd backend && npm run build && npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "sleepApplication": false
  }
}
